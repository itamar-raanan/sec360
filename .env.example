# ══════════════════════════════════════════════════════════════════════════════
# SEC360 — Environment Configuration
# Copy to .env and fill in all required values before first run.
# Run ./setup.sh for guided setup.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Sec360
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# These are used by docker-compose. DB_URL is set automatically from them.
POSTGRES_DB=sec360
POSTGRES_USER=sec360
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_a_64_char_random_hex_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# ── CORS ──────────────────────────────────────────────────────────────────────
# Add your actual hostname/IP, e.g.: ["https://sec360.company.com"]
CORS_ORIGINS=["https://localhost","https://sec360.company.com"]

# ── Ports (optional — defaults: 80 and 443) ───────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443

# ── Collector schedule ────────────────────────────────────────────────────────
# How often (minutes) the background sync runs for all connected integrations
COLLECTOR_INTERVAL_MINUTES=15

# ══════════════════════════════════════════════════════════════════════════════
# INTEGRATIONS — all optional; configure via the UI after first login
# Credentials saved here override what's stored in the database
# ══════════════════════════════════════════════════════════════════════════════

# ── JumpCloud ─────────────────────────────────────────────────────────────────
# Admin API Key from JumpCloud Admin Console → API Settings
JUMPCLOUD_API_KEY=

# ── SentinelOne ───────────────────────────────────────────────────────────────
SENTINELONE_URL=https://your-tenant.sentinelone.net
SENTINELONE_API_TOKEN=

# ── Symantec DLP (direct DB connection) ──────────────────────────────────────
SYMANTEC_DB_HOST=
SYMANTEC_DB_PORT=5432
SYMANTEC_DB_NAME=symantec_dlp
SYMANTEC_DB_USER=
SYMANTEC_DB_PASSWORD=

# ── Puppet (PuppetDB REST API) ────────────────────────────────────────────────
PUPPET_BASE_URL=https://puppet.company.com:8081
PUPPET_API_TOKEN=

# ── Active Directory (LDAP) ───────────────────────────────────────────────────
AD_LDAP_HOST=dc.company.com
AD_LDAP_PORT=389
AD_BASE_DN=DC=company,DC=com
AD_BIND_DN=CN=sec360-svc,OU=ServiceAccounts,DC=company,DC=com
AD_BIND_PASSWORD=
AD_USE_SSL=false

# ── Google Workspace ──────────────────────────────────────────────────────────
GOOGLE_WORKSPACE_DOMAIN=yourcompany.com
# Paste the full JSON key file on one line, or leave blank and configure via UI
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── HiBob ─────────────────────────────────────────────────────────────────────
HIBOB_SERVICE_USER_ID=
HIBOB_SERVICE_TOKEN=

# ══════════════════════════════════════════════════════════════════════════════
# SAML SSO (optional — leave blank to disable, use password login)
# ══════════════════════════════════════════════════════════════════════════════
# Set up a SAML app in your IdP pointing to your SEC360 hostname.
# SP Entity ID — unique URI for this installation
SAML_SP_ENTITY_ID=https://sec360.company.com
# ACS URL — where your IdP POSTs the SAML assertion
SAML_SP_ACS_URL=https://sec360.company.com/api/auth/saml/acs
# Values from your IdP metadata:
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
# IdP signing certificate (no BEGIN/END headers, single line)
SAML_IDP_CERT=
# Role assigned to first-time SSO users (viewer | analyst | admin)
SAML_DEFAULT_ROLE=viewer
