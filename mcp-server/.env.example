SEC360_URL=https://sec360.example.com
SEC360_API_KEY=sec360_REPLACE_WITH_PERSONAL_KEY

# Keep TLS verification enabled. For a private CA, set its certificate path.
SEC360_VERIFY_SSL=true
# SEC360_CA_BUNDLE=/etc/company-ca/sec360-ca.crt
SEC360_TIMEOUT_SECONDS=30

# stdio is recommended for per-user desktop MCP clients.
SEC360_MCP_TRANSPORT=stdio
SEC360_MCP_HOST=127.0.0.1
SEC360_MCP_PORT=9000
